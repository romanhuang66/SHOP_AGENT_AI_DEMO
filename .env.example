# 服务端密钥，不要加 NEXT_PUBLIC_ 前缀。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# browser：浏览器语音识别和朗读；deepseek：使用 DeepSeek ASR/TTS 服务
VOICE_PROVIDER=deepseek

# 私有管理员配置，只在本地或平台服务端填写
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 上线前填写云数据库；密钥仅服务端使用，不使用 NEXT_PUBLIC_ 前缀
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 可选：仅本地开发时用文件存储；线上不会使用此覆盖
# STORAGE_BACKEND=local
