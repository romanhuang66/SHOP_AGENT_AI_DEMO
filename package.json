{
  "name": "shopagent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:business": "node scripts/test-business.mjs",
    "test:agent": "node scripts/test-agent.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:agent:live": "node scripts/test-agent-live.mjs",
    "test:voice:live": "node scripts/test-voice-live.mjs",
    "test:admin": "node scripts/test-admin.mjs",
    "test:admin:live": "SHOP_LIVE=1 node scripts/test-admin.mjs",
    "test:persistence": "node scripts/test-persistence.mjs",
    "check:cloud": "node scripts/cloud-db.mjs",
    "migrate:cloud": "node scripts/cloud-db.mjs --migrate-workspace",
    "configure:vercel": "node scripts/configure-vercel-env.mjs",
    "test:restart": "node scripts/test-restart.mjs",
    "test:errors": "node scripts/test-errors.mjs",
    "test:commerce": "node scripts/test-commerce.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
